---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex>
  <div class="wrap" style="padding:90px 22px;text-align:center">
    <span class="eyebrow">Signal lost</span>
    <h1 style="font-size:2.6rem;margin:12px 0">This page vanished without a trace</h1>
    <p style="color:var(--muted)">Possibly abducted. Try the feed instead.</p>
    <p style="margin-top:26px"><a class="btn" href="/feed/">Open The Feed</a></p>
  </div>
</Base>
