---
import '../styles/global.css';
import { items } from '../lib/data';
interface Props { title?: string; description?: string; image?: string; type?: string; noindex?: boolean }
const { title, description = 'The Fringe Feed tracks the strange in real time: UFOs and UAP, the paranormal, cryptids, ancient mysteries and fringe science, plus original reporting.', image = '/img/og-default.png', type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | The Fringe Feed` : 'The Fringe Feed | Dispatches from the far edge of everything';
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ['/feed/', 'The Feed'], ['/videos/', 'Videos'], ['/originals/', 'Originals'], ['/florida/', 'Florida Fringe'], ['/sources/', 'Sources'], ['/about/', 'About'],
];
const latest = items.slice(0, 3);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="The Fringe Feed Originals" href="/rss.xml" />
  <meta name="theme-color" content="#0a0c10" />
  <meta property="og:site_name" content="The Fringe Feed" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  {noindex && <meta name="robots" content="noindex" />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="The Fringe Feed home">
        <svg class="mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="22" fill="none" stroke="#5ef2b0" stroke-width="3" opacity=".4"/><circle cx="32" cy="32" r="12" fill="none" stroke="#5ef2b0" stroke-width="3"/><circle cx="32" cy="32" r="4.5" fill="#5ef2b0"/></svg>
        <span>The Fringe <b>Feed</b></span>
      </a>
      <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav class="nav" id="nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  {latest.length > 0 && (
    <div class="ticker" aria-label="Latest headlines">
      <div class="wrap">
        <span class="live"><span class="dot"></span>Live feed</span>
        <span class="scroll">{latest.map((i, n) => <>{n > 0 && <span aria-hidden="true"> &nbsp;·&nbsp; </span>}<a href={i.link} rel="noopener nofollow" target="_blank">{i.title}</a></>)}</span>
      </div>
    </div>
  )}
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <a class="brand" href="/"><span>The Fringe <b>Feed</b></span></a>
          <p>Dispatches from the far edge of everything. We collect the best reporting on the strange from across the web, link straight to the original source, and publish our own long-form investigations.</p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>{nav.slice(0, 5).map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <h4>The fine print</h4>
          <ul><li><a href="/about/">About</a></li><li><a href="/policy/">Sources and removals</a></li><li><a href="/rss.xml">RSS (Originals)</a></li></ul>
        </div>
      </div>
      <p class="fine">Aggregated headlines and excerpts belong to their publishers and link to the original articles. Videos play through YouTube's embedded player. © {new Date().getFullYear()} The Fringe Feed.</p>
    </div>
  </footer>
  <script>
    const b = document.querySelector('.menu-btn'); const n = document.getElementById('nav');
    b?.addEventListener('click', () => { const o = n!.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  </script>
</body>
</html>
